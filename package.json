{
  "name": "electron-game",
  "version": "1.0.0",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "build:main": "tsc -p .",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev:main": "tsc -w -p .",
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:vite\" \"npm run dev:electron\""
  },
  "build": {
    "appId": "com.deinname.electron-game",
    "win": {
      "icon": "assets/icon.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnold-grw/electron-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/arnold-grw/electron-game/issues"
  },
  "homepage": "https://github.com/arnold-grw/electron-game#readme",
  "description": "",
  "dependencies": {
    "stats.js": "^0.17.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.179.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^27.0.0-alpha.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
